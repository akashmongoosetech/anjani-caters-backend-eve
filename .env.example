NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=YOUR_GEMINI_API_KEY


# SMTP (nodemailer) — NOTE: Render free tier blocks SMTP ports; use a host that permits outbound SMTP or a paid Render instance.
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@anjanievents.in
SMTP_PASS=YOUR_SMTP_APP_PASSWORD
SMTP_FROM="Anjani Catering & Events <sales@anjanievents.in>"


ADMIN_EMAIL=sales@anjanievents.in
COMPANY_NAME=Anjani Catering & Events
COMPANY_EMAIL=sales@anjanievents.in
COMPANY_PHONE=+91-9685533878
COMPANY_ADDRESS=Maharastra Marg, Rani ki Bagiya, Chhatarpur, Madhya Pradesh 471001, India
