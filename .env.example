NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_IN_PRODUCTION
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# IPstack visitor geolocation (free plan uses HTTP; HTTPS requires a paid plan)
IPSTACK_API_KEY=YOUR_IPSTACK_API_KEY
IPSTACK_BASE_URL=http://api.ipstack.com
VISITOR_RETENTION_DAYS=90


# Brevo Email Configuration (Primary Production Email Provider - REST API)
BREVO_API_KEY=YOUR_BREVO_V3_API_KEY_HERE
BREVO_SENDER_EMAIL=sales@anjanievents.in
BREVO_SENDER_NAME=Anjani Events
BREVO_REPLY_TO_EMAIL=sales@anjanievents.in
BREVO_REPLY_TO_NAME=Anjani Events

# SMTP (Brevo SMTP Relay Fallback - NOTE: SMTP Password is DIFFERENT from API Key!)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=sales@anjanievents.in
SMTP_PASS=YOUR_BREVO_SMTP_PASSWORD_HERE
SMTP_FROM="Anjani Events <sales@anjanievents.in>"


ADMIN_EMAIL=sales@anjanievents.in
ADMIN_PASSWORD=CHANGE_ME_min8chars_set_in_env_only
ADMIN_NAME=Executive Admin
ADMIN_FIRST_NAME=Akash
ADMIN_LAST_NAME=Raikwar
ADMIN_MOBILE=+919685533878
# Optional: ADMIN_USERNAME=sales@anjanievents.in
COMPANY_NAME=Anjani Catering & Events
COMPANY_EMAIL=sales@anjanievents.in
COMPANY_PHONE=+91-9685533878
COMPANY_ADDRESS=Maharastra Marg, Rani ki Bagiya, Chhatarpur, Madhya Pradesh 471001, India
MAX_FILE_SIZE=10485760
UPLOAD_PATH=uploads
